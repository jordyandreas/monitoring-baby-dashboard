# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# When false, screens do not call Supabase and feature routes stay public.
NEXT_PUBLIC_SUPABASE_ENABLED=false

# Web Push public key (safe for the browser). Generate a pair with:
# npx web-push generate-vapid-keys
# Put the private key only in Supabase secrets as VAPID_PRIVATE_KEY,
# plus VAPID_PUBLIC_KEY and VAPID_SUBJECT=mailto:you@example.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
