# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Master switch. false keeps the app on localStorage only.
NEXT_PUBLIC_SUPABASE_ENABLED=false

# Domain sync defaults to on when the master switch is true.
# Set a flag to false to keep that domain on localStorage only.
# NEXT_PUBLIC_SUPABASE_SYNC_BABY=false
# NEXT_PUBLIC_SUPABASE_SYNC_KICKS=false
# NEXT_PUBLIC_SUPABASE_SYNC_WATER=false
# NEXT_PUBLIC_SUPABASE_SYNC_VITAMINS=false
# NEXT_PUBLIC_SUPABASE_SYNC_BABY_PLUS=false
# NEXT_PUBLIC_SUPABASE_SYNC_REMINDERS=false
# NEXT_PUBLIC_SUPABASE_SYNC_CHILD=false
